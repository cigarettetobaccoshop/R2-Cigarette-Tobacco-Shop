# Salin file ini menjadi .env.local lalu isi nilainya.
# Situs TETAP BERFUNGSI PENUH (katalog, keranjang, checkout via WhatsApp) tanpa
# variabel di bawah ini — semuanya untuk fitur backend opsional (Fase 2).

# --- Supabase (untuk dashboard admin & penyimpanan pesanan) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gateway WhatsApp untuk notifikasi otomatis (pilih salah satu: Fonnte/Wablas/Whacenter) ---
FONNTE_TOKEN=

# --- Cek ongkir otomatis (RajaOngkir via Komerce, atau Binderbyte) ---
RAJAONGKIR_API_KEY=
